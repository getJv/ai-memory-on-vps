#!/bin/sh
set -eu

DB="{{ deployment_dir }}/data/memory.sqlite"
BACKUP_DIR="{{ ai_memory_backup_dir }}"
LOCK_FILE="${BACKUP_DIR}/.backup.lock"

[ -f "$DB" ] || exit 0
mkdir -p "$BACKUP_DIR"
umask 077

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
tmp_file="${BACKUP_DIR}/.memory.sqlite.${timestamp}.tmp"
backup_file="${BACKUP_DIR}/memory.sqlite.${timestamp}.bak"
trap 'rm -f "$tmp_file"' EXIT

sqlite3 "$DB" ".backup '$tmp_file'"
mv "$tmp_file" "$backup_file"
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'memory.sqlite.*.bak' -mtime +{{ ai_memory_backup_retention_days }} -delete
trap - EXIT
